+ * member is destroyed at the end of the declaration.  Bind a value, or bind a
+ * reference to `*reader` instead, which is lifetime extended.
+ */
+template <typename T>
+struct arrow_proxy
+{
+    T value;
+    const T* operator->() const { return std::addressof(value); }
+};
